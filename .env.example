# URL-ul backend-ului EcoPulse. Lasă gol pentru a folosi datele mock din browser.
VITE_API_URL=

# Opțional: furnizor de tile-uri pentru hartă (implicit OpenStreetMap).
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=

# Google Maps JavaScript API. Dacă e setată, harta folosește Google Maps în loc de OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID din Google Cloud Console (necesar pentru markerii avansați). Implicit: DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
